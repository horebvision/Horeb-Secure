# =============================================================================
# SECURIA — Variables d'Environnement
# =============================================================================
# Copiez ce fichier en .env.local (dev), .env.staging, ou utilisez
# les secrets de votre plateforme de déploiement (Vercel, Railway, etc.)
# en production.
#
# ⚠️  NE JAMAIS COMMITTER .env.local, .env.staging, ou .env.production
#     dans le dépôt Git. Seul ce fichier (.env.example) est versionné.
# =============================================================================

# ── Identité Application ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="SECURIA"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# URL publique de l'application (sans slash final)
# dev     : http://localhost:3000
# staging : https://staging.securia.example.com
# prod    : https://app.securia.example.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environnement d'exécution (development | staging | production)
NEXT_PUBLIC_APP_ENV="development"

# ── Supabase ──────────────────────────────────────────────────────────────────
# URL du projet Supabase (visible côté client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Clé anonyme Supabase (visible côté client — ne donne accès qu'aux données
# autorisées par les Row Level Security policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Clé service_role Supabase — JAMAIS exposée au client
# Utilisée uniquement dans les API routes et Server Components
# Accordez les permissions minimales nécessaires
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── JWT (facultatif — pour la vérification locale des tokens) ─────────────────
# Disponible dans Settings > API > JWT Secret de votre projet Supabase
# SUPABASE_JWT_SECRET="your-jwt-secret"

# ── Cartographie ──────────────────────────────────────────────────────────────
# Leaflet utilise OpenStreetMap par défaut (aucune clé requise pour le MVP).
# Pour passer à Mapbox ou Google Maps en production, définissez la clé ici.
# NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1IjoiLi4uIn0.xxx"
# NEXT_PUBLIC_GOOGLE_MAPS_KEY="AIza..."

# ── Notifications Push (Web Push / FCM — Phase 2) ────────────────────────────
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY="your-vapid-private-key"
# VAPID_SUBJECT="mailto:tech@securia.example.com"

# ── SMS (Twilio — Phase 2) ────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# TWILIO_FROM_PHONE="+22500000000"

# ── Email (Resend / SendGrid — Phase 2) ───────────────────────────────────────
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="noreply@securia.example.com"

# ── Monitoring & Observabilité (Phase 2) ─────────────────────────────────────
# SENTRY_DSN="https://xxx@o0.ingest.sentry.io/0"
# SENTRY_ORG="securia"
# SENTRY_PROJECT="securia-nextjs"
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@o0.ingest.sentry.io/0"

# ── Rate Limiting avancé (Upstash Redis — Phase 2) ───────────────────────────
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── Analytiques (Phase 2) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY="phc_xxx"
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
